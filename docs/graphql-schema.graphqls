"Ein Unterauftrag, auf den gebucht werden darf"
type BookableSuborder {
  "Ob eine Buchung dort eine Beschreibung braucht"
  commentNecessary: Boolean!
  "Das vollständige Zeichen, z. B. ABC-12/01"
  completeOrderSign: String!
  "Die Bezeichnung, wie das Buchungsformular sie zeigt"
  description: String!
  "Der Mitarbeiterauftrag, an dem eine Buchung dort hängt"
  employeeorderId: ID!
  "Die id des Unterauftrags, anzugeben in createTimereport"
  suborderId: ID!
}

"Ein Kunde, mit dem, was die Kundenliste zeigt"
type Customer {
  "Die Adresse"
  address: String
  "Ob der Kunde in Auswahllisten ausgeblendet ist"
  hidden: Boolean!
  "Die id"
  id: ID!
  "Der Name"
  name: String
  "Das Kundensegment, null ohne eines"
  segment: CustomerSegment
  "Das Kürzel, an dem der Kunde in jeder Auswahl erkannt wird"
  shortName: String!
}

"Ein Kundensegment"
type CustomerSegment {
  "Die id"
  id: ID!
  "Der Name"
  name: String!
}

"Ein Auftrag, mit dem, was die Auftragsliste allen zeigt, die sie öffnen dürfen"
type Customerorder {
  "Die oder der Verantwortliche bei HBT für den Vertrag, null ohne"
  contractResponsible: PersonRef
  "Der Kunde"
  customer: Customer!
  "Die Soll-Stunden, PT0S ohne Vorgabe"
  debitHours: Duration!
  "Worauf sich die Soll-Stunden beziehen, null ohne Angabe"
  debitHoursUnit: DebitHoursUnit
  "Die Beschreibung"
  description: String
  "Die Verantwortlichen bei HBT für die Durchführung"
  executionResponsibles: [PersonRef!]!
  "Ob der Auftrag in Auswahllisten ausgeblendet ist"
  hidden: Boolean!
  "Die id"
  id: ID!
  "Das Zeichen, z. B. ABC-12"
  sign: String!
  "Die Namen der Tags"
  tags: [String!]!
  "Der erste Tag der Gültigkeit"
  validFrom: Date!
  "Der letzte Tag der Gültigkeit, null für unbefristet"
  validUntil: Date
}

"Die Antwort auf Löschen"
type DeletePayload {
  "Die id des gelöschten Objekts"
  id: ID!
}

"Die angemeldete Person"
type Me {
  "Worauf die Person an diesem Tag buchen darf: jeder Unterauftrag mit einem dann gültigen Mitarbeiterauftrag"
  bookableSuborders(
    "Der Tag, für den gebucht werden soll"
    on: Date!
  ): [BookableSuborder!]!
  "Der heute gültige Vertrag, null ohne einen"
  currentContractId: ID
  "Die id der Person, zum Beispiel für den Filter der Buchungsliste"
  employeeId: ID!
  "Der Name"
  name: String!
  "Die Rollen, die sich aus der Stufe ergeben; sie sind kumulativ, eine Geschäftsführung ist auch People Lead"
  roles: [Role!]!
  "Das Kürzel"
  sign: String!
  "Die Berechtigungsstufe des Logins"
  status: LoginStatus!
}

"Schreibende Einstiege; jede Mutation ist eine eigene Transaktion"
type Mutation {
  """
  Legt eine eigene Buchung an. Eine Wiederholung mit demselben Schlüssel und derselben Eingabe legt nichts an und
  antwortet mit der damals angelegten Buchung (replayed: true); wurde sie inzwischen gelöscht, mit TR-0001.
  Typische Fehler: TR-0024 kein Arbeitsbeginn am Tag (erst upsertWorkingday), TR-0002 kein Vertrag am Tag, TR-0003
  kein Mitarbeiterauftrag auf dem Unterauftrag am Tag, TR-0019 Beschreibung fehlt, obwohl der Unterauftrag sie
  verlangt, TR-0012, TR-0013 oder TR-0026 der Zeitraum ist schon freigegeben oder abgenommen, XX-0006 Schlüssel mit anderer Eingabe
  verwendet, XX-0007 Schlüssel zu lang.
  """
  createTimereport(
    "Vom Aufrufer erzeugt, z. B. eine UUID, 1 bis 100 Zeichen, einmal je Vorhaben und bei jeder Wiederholung unverändert"
    idempotencyKey: ID!,
    "Die Buchung"
    input: CreateTimereportInput!
  ): TimereportPayload!
  """
  Löscht eine Buchung, wie die Oberfläche. Typische Fehler: TR-0001 nicht gefunden oder nicht sichtbar, TR-0012,
  TR-0013 oder TR-0026 der Zeitraum ist schon freigegeben oder abgenommen.
  """
  deleteTimereport(
    "Die Buchung"
    id: ID!
  ): DeletePayload!
  """
  Trägt für den Tag „Nicht gearbeitet" ein: Arbeitsbeginn 00:00, Pause PT0S. Nur an einem Tag ohne Buchung, sonst
  WD-0001.
  """
  markNotWorked(
    "Der Tag"
    date: Date!
  ): Workingday!
  """
  Ändert eine Buchung, die der Aufrufer in version gelesen hat. Nicht angegebene Felder bleiben, wie sie sind; ein
  neuer Tag nimmt den an diesem Tag gültigen Vertrag und Mitarbeiterauftrag. Typische Fehler: XX-0003 die Buchung
  wurde seit dem Lesen geändert (neu lesen und erneut anwenden), TR-0001 nicht gefunden oder nicht sichtbar, TR-0003
  am neuen Tag kein Mitarbeiterauftrag, TR-0012, TR-0013 oder TR-0026 der Zeitraum ist schon freigegeben oder abgenommen.
  """
  updateTimereport(
    "Die Buchung"
    id: ID!,
    "Die Felder, die sich ändern"
    input: UpdateTimereportInput!,
    "Die Version, in der die Buchung gelesen wurde"
    version: Int!
  ): TimereportPayload!
  """
  Trägt den eigenen Arbeitstag ein oder ändert ihn, mit den Regeln der Tagesansicht. Typische Fehler: TR-0002 kein
  Vertrag am Tag, WD-0011 der Tag liegt außerhalb des Vertrags, der Zeitraum ist schon freigegeben oder abgenommen.
  """
  upsertWorkingday(
    "Der Arbeitstag"
    input: WorkingdayInput!
  ): Workingday!
}

"Ein Zeitraum, in dem eine Person auf einem Auftrag gearbeitet hat"
type OrderHistoryEntry {
  "An wie vielen Tagen im Zeitraum gebucht wurde"
  bookedDays: Int!
  "Der Auftrag, auf dessen Unteraufträge gebucht wurde"
  customerorder: Customerorder!
  "Die Summe der Buchungen im Zeitraum"
  duration: Duration!
  "Der erste Buchungstag des Zeitraums"
  from: Date!
  "Der letzte Buchungstag des Zeitraums"
  until: Date!
}

"Eine Person, mit id, Kürzel und Name"
type PersonRef {
  "Die id der Person"
  id: ID!
  "Der Name"
  name: String!
  "Das Kürzel, nur zur Anzeige; Personen werden über ihre id angesprochen"
  sign: String!
}

"Lesende Einstiege"
type Query {
  "Die angemeldete Person mit ihrem laufenden Vertrag"
  me: Me!
  """
  In welchen Zeiträumen eine Person auf welchem Auftrag gearbeitet hat, aus ihren Buchungen über die ganze Zeit. Ein
  Zeitraum reicht vom ersten bis zum letzten Buchungstag; liegen dazwischen 30 Tage oder mehr ohne Buchung auf dem
  Auftrag, beginnt ein neuer Zeitraum, und der Auftrag kommt erneut vor. Es zählen nur die Buchungen, die die
  angemeldete Person nach den Regeln der Buchungsliste sehen darf (siehe timereportList); wer für einen Auftrag
  verantwortlich ist, sieht von anderen Personen also nur die Zeiträume auf diesem Auftrag. Eine Person ohne
  sichtbare Buchung ergibt eine leere Liste. Der jüngste Zeitraum steht vorn. Eingeschränkte Anmeldungen bekommen
  AA-0002.
  """
  orderHistory(
    "Die Person (Me.employeeId); ohne Angabe die angemeldete"
    employeeId: ID
  ): [OrderHistoryEntry!]!
  "Eine Buchung, null, wenn es sie nicht gibt oder die angemeldete Person sie nicht sehen darf"
  timereport(
    "Die id der Buchung"
    id: ID!
  ): Timereport
  """
  Buchungen nach denselben Sichtbarkeitsregeln wie die Buchungsliste der Oberfläche: Mitarbeitende sehen ihre
  eigenen, People Leads die ihres Teams, Verantwortliche die ihrer Aufträge, das Backoffice die auf fakturierbaren
  Unteraufträgen, die Geschäftsführung alle; dazu kommen einzeln vergebene Regeln. Die Zeilen sind auf limit
  begrenzt, die Summen zählen alle Treffer. Eingeschränkte Anmeldungen bekommen AA-0002.
  """
  timereportList(
    "Was gesucht wird"
    filter: TimereportListFilter!
  ): TimereportPage!
  "Die eigenen Buchungen eines Zeitraums, höchstens 366 Tage (sonst GQ-0001)"
  timereports(
    "Erster Tag, eingeschlossen"
    from: Date!,
    "Letzter Tag, eingeschlossen"
    until: Date!
  ): [Timereport!]!
  "Der eigene Arbeitstag, null, wenn für den Tag keiner eingetragen ist"
  workingday(
    "Der Tag"
    date: Date!
  ): Workingday
}

"Ein Unterauftrag, mit id und Zeichen"
type SuborderRef {
  "Das vollständige Zeichen, z. B. ABC-12/01"
  completeOrderSign: String!
  "Die id"
  id: ID!
}

"Eine Buchung"
type Timereport {
  "Der Tag"
  date: Date!
  "Die Dauer"
  duration: Duration!
  "Die Person der Buchung, mit id, Kürzel und Name"
  employee: PersonRef!
  "Der Mitarbeiterauftrag, an dem die Buchung hängt"
  employeeorderId: ID!
  "Die id"
  id: ID!
  "Wie weit der Zeitraum der Buchung freigegeben ist"
  status: TimereportStatus!
  "Der Unterauftrag der Buchung, mit id und vollständigem Zeichen"
  suborder: SuborderRef!
  "Die Beschreibung"
  taskDescription: String
  "Die Ticketreferenzen in ihrer Reihenfolge"
  ticketReferences: [String!]!
  "Ob die Buchung als Fortbildung zählt"
  training: Boolean!
  "Die Version, in der die Buchung gelesen wurde; anzugeben in updateTimereport"
  version: Int!
}

"Eine Seite der Buchungsliste"
type TimereportPage {
  "Der Teil davon auf fakturierbaren Unteraufträgen"
  billableDuration: Duration!
  "Die Zeilen, auf limit begrenzt"
  items: [Timereport!]!
  "Wie viele Buchungen der Filter trifft"
  totalCount: Int!
  "Ihre Dauer"
  totalDuration: Duration!
  "true, wenn es mehr Treffer als Zeilen gibt"
  truncated: Boolean!
}

"Die Antwort auf Anlegen und Ändern"
type TimereportPayload {
  "true, wenn die Antwort aus einem früheren Aufruf mit demselben Schlüssel stammt"
  replayed: Boolean!
  "Die Buchung in ihrem jetzigen Stand"
  timereport: Timereport!
}

"Ein Arbeitstag"
type Workingday {
  "Die Pause"
  breakLength: Duration!
  "Der Tag"
  date: Date!
  "Der Arbeitsbeginn; 00:00 an einem Tag „Nicht gearbeitet“"
  startTime: Time!
  "Gearbeitet oder nicht gearbeitet"
  type: WorkingDayType!
}

"Welche Buchungen nach Fakturierbarkeit"
enum Billable {
  "Alle Buchungen"
  ALL
  "Nur Buchungen auf fakturierbaren Unteraufträgen"
  BILLABLE
  "Nur die übrigen"
  NOT_BILLABLE
}

"Worauf sich die Soll-Stunden eines Auftrags beziehen"
enum DebitHoursUnit {
  "Auf einen Monat"
  MONTH
  "Auf die gesamte Laufzeit"
  TOTAL
  "Auf ein Jahr"
  YEAR
}

"Die Berechtigungsstufe eines Logins"
enum LoginStatus {
  "Administration"
  ADMIN
  "Backoffice"
  BACKOFFICE
  "Mitarbeitende"
  EMPLOYEE
  "Geschäftsführung"
  MANAGEMENT
  "People Lead"
  PEOPLE_LEAD
  "Eingeschränkt, etwa für Externe: sieht nur die eigenen Einsätze"
  RESTRICTED
}

"Eine Rolle, die sich aus der Berechtigungsstufe ergibt"
enum Role {
  "Darf alles, auch die Administration"
  ADMIN
  "Sieht die Buchungen auf fakturierbaren Unteraufträgen"
  BACKOFFICE
  "Darf Stammdaten pflegen und sieht alle Buchungen"
  MANAGER
  "Sieht die Buchungen des eigenen Teams"
  PEOPLE_LEAD
  "Eingeschränkte Anmeldung"
  RESTRICTED
}

"Wie weit der Zeitraum einer Buchung freigegeben ist"
enum TimereportStatus {
  "Abgenommen: ändern darf nur die Administration, auch sie nicht an eigenen Buchungen"
  CLOSED
  "Freigegeben: ändern dürfen die Geschäftsführung und der zuständige People Lead, die Person selbst nicht"
  COMMITTED
  "Offen: ändern dürfen die Person selbst und die Geschäftsführung"
  OPEN
}

"Die Art eines Arbeitstags"
enum WorkingDayType {
  "Nicht gearbeitet"
  NOT_WORKED
  "Gearbeitet"
  WORKED
}

"Ein Tag nach ISO-8601, z. B. 2026-10-26"
scalar Date

"Eine Dauer nach ISO-8601, z. B. PT1H30M"
scalar Duration

"Eine Uhrzeit nach ISO-8601, z. B. 08:30"
scalar Time

"Eine neue Buchung"
input CreateTimereportInput {
  "Der Tag"
  date: Date!
  "Die Dauer, größer als null und höchstens PT24H (sonst TR-0008 bzw. TR-0030)"
  duration: Duration!
  "Der Unterauftrag, siehe Me.bookableSuborders"
  suborderId: ID!
  "Die Beschreibung, höchstens 32000 Zeichen (TR-0005); Pflicht, wo der Unterauftrag commentNecessary hat (TR-0019)"
  taskDescription: String!
  "Die Ticketreferenzen, je höchstens 64 Zeichen (TR-0032); ob und wie viele erlaubt sind, bestimmt der Unterauftrag (TR-0049, TR-0050)"
  ticketReferences: [String!]
}

"Jede Liste ist eine Alternative; leer oder weggelassen heißt: keine Einschränkung in dieser Hinsicht"
input TimereportListFilter {
  "Alle, nur fakturierbare oder nur nicht fakturierbare"
  billable: Billable = ALL
  "Auf welchen Kunden"
  customerIds: [ID!]
  "Auf welchen Aufträgen, jeweils mit dem ganzen Baum"
  customerorderIds: [ID!]
  "Wessen Buchungen, als id der Person (Me.employeeId)"
  employeeIds: [ID!]
  "Erster Tag, eingeschlossen"
  from: Date!
  "Wie viele Zeilen, 1 bis 200 (sonst GQ-0002)"
  limit: Int = 100
  "Auf welchen Unteraufträgen, jeweils mit dem ganzen Zweig"
  suborderIds: [ID!]
  "Letzter Tag, eingeschlossen; höchstens 366 Tage nach from (sonst GQ-0001)"
  until: Date!
}

"Was sich an einer Buchung ändert; weggelassene Felder bleiben"
input UpdateTimereportInput {
  "Der neue Tag"
  date: Date
  "Die neue Dauer, größer als null und höchstens PT24H"
  duration: Duration
  "Die neue Beschreibung, höchstens 32000 Zeichen"
  taskDescription: String
  "Die neuen Ticketreferenzen; eine leere Liste entfernt alle"
  ticketReferences: [String!]
}

"Ein eigener Arbeitstag"
input WorkingdayInput {
  "Die Pause, ohne Angabe keine"
  breakLength: Duration
  "Der Tag"
  date: Date!
  "Der Arbeitsbeginn"
  startTime: Time!
  "Ohne Angabe bleibt die Art, wie sie ist; ein neuer Tag ist gearbeitet"
  type: WorkingDayType
}
