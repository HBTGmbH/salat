  <build>
    <finalName>tb</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build-info</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <image>
            <name>${salat.image.name}:${salat.image.tag}</name>
            <env>
              <BP_JVM_VERSION>${java.version}</BP_JVM_VERSION>
              <!--
              Metaspace-Grenze (#1213). Der Memory Calculator schätzt die geladenen Klassen als
              (JVM- + App- + Agent-Klassen) x Faktor x 0,35 und setzt MaxMetaspaceSize auf
              Klassen x 5.800 Byte + 14 MiB. Mit dem Vorgabefaktor 100 % kommt er auf 29.089
              Klassen und 178.433K (174 MiB). Zur Laufzeit geladen sind bis zu 34.600 Klassen mit
              159 MiB Metaspace, das 1,19-Fache der Schätzung; beim Erreichen der Grenze endet die
              JVM mit OutOfMemoryError: Metaspace.

              Faktor 160 %: 46.543 Klassen, MaxMetaspaceSize 277.294K (271 MiB). Das liegt 34 %
              über der höchsten beobachteten Klassenzahl und 70 % über dem höchsten beobachteten
              Metaspace; 155 % wären das Minimum für 30 % Reserve auf die Klassenzahl.

              Ein Faktor statt einer festen Zahl (BPL_JVM_LOADED_CLASS_COUNT): die Zählung aus dem
              Archiv läuft bei jedem Build neu und wächst mit den Abhängigkeiten mit. Metaspace wird
              erst bei Bedarf belegt; der Heap wird um die Differenz kleiner gerechnet, rund 97 MiB
              bei jedem Speicherlimit. Die festen Bereiche brauchen damit 771 MiB, darunter meldet
              der Memory Calculator einen Fehler und die Anwendung startet nicht.

              BPE_DEFAULT_* schreibt die Laufzeitvariable als Vorgabe ins Image (Buildpack
              environment-variables, vom Java-Buildpack eingebunden, sobald eine BPE_-Variable
              gesetzt ist); ein BPL_JVM_CLASS_ADJUSTMENT der Laufzeitumgebung geht weiter vor.
              Prüfen lässt sich der Wert an der Startzeile "Calculated JVM Memory Configuration".
              -->
              <BPE_DEFAULT_BPL_JVM_CLASS_ADJUSTMENT>160%</BPE_DEFAULT_BPL_JVM_CLASS_ADJUSTMENT>
              <!--
              AOT-Cache (#1278, JEP 483/514/515). Beim Image-Build startet der Buildpack die
              Anwendung einmal bis zum Ende des Context-Refresh und legt die dabei geladenen und
              gelinkten Klassen im Image ab; der Start im Betrieb liest sie von dort statt aus den
              JARs. Lokal gemessen: 7,8 s mit java -jar, 3,65 s entpackt mit Cache.

              Beim Build gibt es keine Datenbank. TRAINING_RUN_JAVA_TOOL_OPTIONS gilt nur für diesen
              Trainingslauf: Liquibase aus, keine Schemavalidierung, kein Lesen der JDBC-Metadaten,
              der Dialekt deshalb fest. Hikari öffnet die erste Verbindung erst bei Bedarf, die nicht
              erreichbare Datenbank-URL stört also nicht. Im Betrieb laufen Liquibase und die
              Schemavalidierung weiter wie bisher. Dass ihre Klassen im Cache fehlen, kostet rund
              0,3 s gegenüber einem Trainingslauf mit Datenbank.

              Code, der beim Start auf die Datenbank zugreift, darf das nicht vor dem Ende des
              Context-Refresh tun, sonst bricht der Trainingslauf und mit ihm der Image-Build ab.
              Passt der Cache nicht zur JVM oder zum Klassenpfad, startet die JVM mit einer Warnung
              ohne ihn.
              -->
              <BP_JVM_AOTCACHE_ENABLED>true</BP_JVM_AOTCACHE_ENABLED>
              <TRAINING_RUN_JAVA_TOOL_OPTIONS>-Dspring.liquibase.enabled=false -Dspring.jpa.hibernate.ddl-auto=none -Dspring.jpa.properties.hibernate.boot.allow_jdbc_metadata_access=false -Dspring.jpa.database-platform=org.hibernate.dialect.MySQLDialect</TRAINING_RUN_JAVA_TOOL_OPTIONS>
            </env>
          </image>
        </configuration>
      </plugin>
      <plugin>
        <groupId>pl.project13.maven</groupId>
        <artifactId>git-commit-id-plugin</artifactId>
        <version>${git-commit-id-plugin.version}</version>
        <configuration>
          <offline>true</offline>
          <generateGitPropertiesFile>true</generateGitPropertiesFile>
          <generateGitPropertiesFilename>${project.build.outputDirectory}/git.properties</generateGitPropertiesFilename>
          <commitIdGenerationMode>full</commitIdGenerationMode>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>revision</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <!-- References to interface static methods are allowed only at source level 1.8 or above -->
        <configuration>
          <compilerArgs>
            <compilerArg>-proc:full</compilerArg>
            <compilerArg>-Xlint</compilerArg>
            <!--
            <compilerArg>-Xdiags:verbose</compilerArg>
            <compilerArg>-verbose</compilerArg>
            <compilerArg>-XprintRounds</compilerArg>
            <compilerArg>-XprintProcessorInfo</compilerArg>
            <compilerArg>-J-verbose</compilerArg>
            -->
          </compilerArgs>
          <release>${java.version}</release>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-Dspring.profiles.active=unittest -XX:+EnableDynamicAgentLoading</argLine>
          <excludes>
            <exclude>**/*E2ETest.java</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <!--
      Runs the Playwright E2E test suite (Chrome + Firefox) against the dailyreport module.
      Requires a one-time local browser install: jenv exec ./mvnw -Pe2e test-compile exec:java@install-playwright-browsers

      Usage - always one browser per run, the browsers in separate runs:
        jenv exec ./mvnw test -Pe2e -De2e.browsers=chrome
        jenv exec ./mvnw test -Pe2e -De2e.browsers=firefox
      Leaving out -De2e.browsers drives both browsers from one JVM against one database. The suite
      shares that database and never cleans up its bookings, so the second browser then sees the
      data of the first one and tests asserting on a per-day total fail for no good reason. The CI
      matrix passes one browser per runner for the same reason (see AGENTS.md, Testing and Quality).

      Watch it run in a visible, slowed-down browser: add -De2e.headless=false -De2e.slowmo=500
    -->
    <profile>
      <id>e2e</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-surefire-plugin</artifactId>
            <configuration>
              <argLine>-Dspring.profiles.active=unittest -XX:+EnableDynamicAgentLoading</argLine>
              <excludes combine.self="override">
                <exclude>none</exclude>
              </excludes>
              <includes>
                <include>**/*E2ETest.java</include>
              </includes>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>install-playwright-browsers</id>
                <phase>none</phase>
                <goals>
                  <goal>java</goal>
                </goals>
                <configuration>
                  <mainClass>com.microsoft.playwright.CLI</mainClass>
                  <classpathScope>test</classpathScope>
                  <arguments>
                    <argument>install</argument>
                    <argument>firefox</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <reporting>
