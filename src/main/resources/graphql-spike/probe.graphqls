# GraphQL-Spike (#1532): Messfelder für den Laufzeitkontext (Konzept 6.4). Werden nicht übernommen.

extend type Query {
  probe: Probe!
}

type Probe {
  "Im Thread der Ausführung, ohne Umweg"
  direct: ProbeResult!
  "Über einen Callable, den Spring for GraphQL auf seinem Executor ausführt; null bei einem Fehler"
  callable: ProbeResult
  "Über CompletableFuture.supplyAsync, also auf einem fremden Thread ohne Kontextweitergabe; null bei einem Fehler"
  foreignThread: ProbeResult
  "Über einen Batch-Loader, je Eintrag"
  batched: [ProbeItem!]!
  "Resolver mit @Authorized(requiresManager = true), Ebene 1"
  resolverRequiresManager: Boolean!
  "Offener Resolver, der eine Service-Methode mit requiresManager ruft, Ebene 2"
  serviceRequiresManager: Boolean!
}

type ProbeItem {
  index: Int!
  result: ProbeResult!
}

type ProbeResult {
  thread: String!
  "Kürzel aus AuthorizedUser (liest den SecurityContext), oder null"
  authorizedUserSign: String
  "Kürzel aus AuthorizedEmployee (vom Filter je Anfrage gefüllt), oder null"
  authorizedEmployeeSign: String
  "Ob dem Thread ein EntityManager gebunden ist (Open-in-View)"
  entityManagerBound: Boolean!
  "Fehler beim Zugriff auf die Request-Scope-Bohnen"
  error: String
}
