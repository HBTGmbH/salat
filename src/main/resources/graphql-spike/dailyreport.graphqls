# GraphQL-Spike (#1532), Modul dailyreport. Es darf order importieren, also definiert es auch die Kante zum
# Unterauftrag (Konzept 3.7).

extend type Query {
  "Die eigenen Buchungen eines Zeitraums, höchstens 366 Tage"
  timereports(from: Date!, until: Date!): [Timereport!]!
  """
  Buchungen nach der Sichtbarkeit der Buchungsliste (#1092): wer was sieht, entscheidet derselbe Service wie in
  der Oberfläche. Die Zeilen sind auf limit begrenzt, die Summen zählen alle Treffer.
  """
  timereportList(filter: TimereportListFilter!): TimereportPage!
}

"Jede Liste ist eine Alternative; leer oder weggelassen heißt: keine Einschränkung in dieser Hinsicht"
input TimereportListFilter {
  from: Date!
  until: Date!
  employeeIds: [ID!]
  customerIds: [ID!]
  customerorderIds: [ID!]
  "Ein Unterauftrag steht für seinen ganzen Zweig"
  suborderIds: [ID!]
  billable: Billable = ALL
  "Höchstens 200"
  limit: Int = 100
}

enum Billable {
  ALL
  BILLABLE
  NOT_BILLABLE
}

type TimereportPage {
  items: [Timereport!]!
  totalCount: Int!
  totalDuration: Duration!
  billableDuration: Duration!
  "true, wenn es mehr Treffer als Zeilen gibt"
  truncated: Boolean!
}

extend type Mutation {
  "Legt eine Buchung an. Eine Wiederholung mit demselben Schlüssel und derselben Eingabe legt nichts an."
  createTimereport(idempotencyKey: ID!, input: CreateTimereportInput!): TimereportPayload!
  "Ändert eine eigene Buchung; nicht angegebene Felder bleiben, wie sie sind."
  updateTimereport(id: ID!, input: UpdateTimereportInput!): TimereportPayload!
}

type Timereport {
  id: ID!
  date: Date!
  duration: Duration!
  taskDescription: String
  ticketReferences: [String!]!
  "open, committed oder closed, wie in der Datenbank"
  status: String!
  training: Boolean!
  employeeorderId: ID!
  "Verweis auf die Person, nicht die volle Person (Konzept 3.3)"
  employee: PersonRef!
  "Verweis auf den Unterauftrag, für alle Buchungen einer Antwort in einem Schritt geladen"
  suborder: SuborderRef!
}

type SuborderRef {
  id: ID!
  completeOrderSign: String!
}

input CreateTimereportInput {
  employeeorderId: ID!
  date: Date!
  duration: Duration!
  taskDescription: String!
  ticketReferences: [String!]
}

input UpdateTimereportInput {
  date: Date
  duration: Duration
  taskDescription: String
  ticketReferences: [String!]
}

type TimereportPayload {
  timereport: Timereport!
  "true, wenn die Antwort aus einem früheren Aufruf mit demselben Schlüssel stammt"
  replayed: Boolean!
}
