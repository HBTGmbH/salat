# Modul employee.

extend type Query {
  "Die angemeldete Person mit ihrem laufenden Vertrag"
  me: Me!
}

"Die angemeldete Person"
type Me {
  "Die id der Person, zum Beispiel für den Filter der Buchungsliste"
  employeeId: ID!
  "Das Kürzel"
  sign: String!
  "Der Name"
  name: String!
  "Die Berechtigungsstufe des Logins"
  status: LoginStatus!
  "Die Rollen, die sich aus der Stufe ergeben; sie sind kumulativ, eine Geschäftsführung ist auch People Lead"
  roles: [Role!]!
  "Der heute gültige Vertrag, null ohne einen"
  currentContractId: ID
}

"Die Berechtigungsstufe eines Logins"
enum LoginStatus {
  "Administration"
  ADMIN
  "Geschäftsführung"
  MANAGEMENT
  "People Lead"
  PEOPLE_LEAD
  "Backoffice"
  BACKOFFICE
  "Mitarbeitende"
  EMPLOYEE
  "Eingeschränkt, etwa für Externe: sieht nur die eigenen Einsätze"
  RESTRICTED
}

"Eine Rolle, die sich aus der Berechtigungsstufe ergibt"
enum Role {
  "Darf alles, auch die Administration"
  ADMIN
  "Darf Stammdaten pflegen und sieht alle Buchungen"
  MANAGER
  "Sieht die Buchungen des eigenen Teams"
  PEOPLE_LEAD
  "Sieht die Buchungen auf fakturierbaren Unteraufträgen"
  BACKOFFICE
  "Eingeschränkte Anmeldung"
  RESTRICTED
}
